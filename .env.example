# LLM Provider
OPENAI_API_KEY=
MODEL=gpt-4-turbo

# Database
MONGO_URI=mongodb://127.0.0.1:27017/listing-agent

# Server
PORT=6001
FRONTEND_URL=http://localhost:3000

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_MAX_AGE_MS=604800000

# AWS SES
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

# AWS S3
AWS_S3_BUCKET=
