# LLM (the model is chosen per call)
OPENAI_API_KEY=

# Agent. The drafting and verification passes default to different models so
# they do not share one model's blind spots. Overrides below are optional;
# defaults are gpt-4.1-mini for drafting and gpt-4.1 for verification.
AGENT_GENERATE_MODEL=
AGENT_VERIFY_MODEL=
AGENT_CONCURRENCY=3

# Database
MONGO_URI=mongodb://127.0.0.1:27017/listing-agent

# Server
PORT=6001
FRONTEND_URL=http://localhost:3000

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_MAX_AGE_MS=604800000

# AWS SES
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

# AWS S3
AWS_S3_BUCKET=
